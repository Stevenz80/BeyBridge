{
  "expo": {
    "name": "BeyBridge",
    "slug": "beybridge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "beybridge",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAFAFA",
    "primaryColor": "#7E5BEF",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.beybridge.app"
    },
    "android": {
      "package": "com.beybridge.app",
      "adaptiveIcon": {
        "backgroundColor": "#F1EDFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/branding/beybridge-logo-white.jpg",
          "imageWidth": 280,
          "resizeMode": "contain"
        }
      ],
      "expo-sqlite",
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow BeyBridge to use your location to sort nearby services."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7E5BEF",
          "defaultChannel": "account-updates"
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}

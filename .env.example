# Copy this file to .env.local and use the values from Supabase Dashboard > Connect.
# The publishable key is designed for client apps. Never place a service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional production crash reporting. The DSN is safe to embed in a client app.
EXPO_PUBLIC_SENTRY_DSN=
# Configure these as EAS build variables alongside a sensitive SENTRY_AUTH_TOKEN.
SENTRY_ORG=
SENTRY_PROJECT=

# Required for store release. Create a real, monitored support inbox first.
EXPO_PUBLIC_LEGAL_OPERATOR=
EXPO_PUBLIC_SUPPORT_EMAIL=
# Describe actual infrastructure retention, including any required exceptions.
EXPO_PUBLIC_BACKUP_RETENTION=
EXPO_PUBLIC_LOG_RETENTION=
# Public, deployed HTML pages; never require login to read them.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_ACCOUNT_DELETION_URL=
